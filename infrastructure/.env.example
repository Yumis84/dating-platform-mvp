# Local environment variables example for Dating Platform MVP

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_placeholder
POSTGRES_DB=dating_mvp_db
POSTGRES_PORT=5432

# n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=n8n_user
N8N_BASIC_AUTH_PASSWORD=n8n_password_placeholder
N8N_HOST=localhost
N8N_PORT=5678

# Telegram (placeholders)
TELEGRAM_BOT_TOKEN=telegram_bot_token_placeholder
MODERATION_CHAT_ID=moderation_chat_id_placeholder

# AI provider
AI_API_KEY=ai_api_key_placeholder
AI_API_URL=https://api.example.com/moderation

# Migration settings (used when running migrate container)
# The migrate command will construct a DB URL like below (example):
# postgres://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB?sslmode=disable
