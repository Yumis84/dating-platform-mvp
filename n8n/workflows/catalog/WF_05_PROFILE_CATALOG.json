      "parameters": {"operation":"executeQuery","query":"SELECT id, display_name AS name, age, city, avatar_file_id, description FROM profiles WHERE status = 'ACTIVE' AND ( ('{{ JSON.parse($json[\"filters\"]).city || '' }}' = '') OR city = '{{ JSON.parse($json[\"filters\"]).city || '' }}') AND ( (COALESCE((JSON.parse($json[\"filters\"]).min_age), '') = '') OR age >= COALESCE((JSON.parse($json[\"filters\"]).min_age)::int, age) ) AND ( (COALESCE((JSON.parse($json[\"filters\"]).max_age), '') = '') OR age <= COALESCE((JSON.parse($json[\"filters\"]).max_age)::int, age) ) ORDER BY created_at DESC LIMIT 50;"},
