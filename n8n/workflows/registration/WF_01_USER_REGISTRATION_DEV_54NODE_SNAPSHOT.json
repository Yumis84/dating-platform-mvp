    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ta AS (\n  SELECT user_id FROM telegram_accounts WHERE telegram_id = {{$('Extract photo vars').item.json.telegram_id}} LIMIT 1\n),\nprof AS (\n  SELECT id FROM profiles WHERE user_id = (SELECT user_id FROM ta) LIMIT 1\n),\nins_photo AS (\n  INSERT INTO profile_photos (profile_id, telegram_file_id, position)\n  SELECT (SELECT id FROM prof),\n         '{{$('Extract photo vars').item.json.file_id}}',\n         COALESCE((SELECT MAX(position) FROM profile_photos WHERE profile_id = (SELECT id FROM prof)), -1) + 1\n  WHERE EXISTS (SELECT 1 FROM prof)\n    AND NOT EXISTS (\n      SELECT 1 FROM profile_photos\n      WHERE profile_id = (SELECT id FROM prof)\n        AND telegram_file_id = '{{$('Extract photo vars').item.json.file_id}}'\n    )\n  RETURNING id\n),\nupd_session AS (\n  UPDATE profile_ai_sessions s\n  SET ai_context = jsonb_set(\n        COALESCE(s.ai_context, '{}'::jsonb),\n        '{pending_photos}',\n        COALESCE(s.ai_context->'pending_photos', '[]'::jsonb)\n          || jsonb_build_array(jsonb_build_object(\n               'telegram_file_id', '{{$('Extract photo vars').item.json.file_id}}',\n               'position', COALESCE(jsonb_array_length(s.ai_context->'pending_photos'), 0)\n             )),\n        true\n      ),\n      updated_at = now()\n  WHERE s.user_id = (SELECT user_id FROM ta)\n    AND s.status = 'IN_PROGRESS'\n    AND NOT EXISTS (SELECT 1 FROM prof)\n    AND NOT EXISTS (\n      SELECT 1 FROM jsonb_array_elements(COALESCE(s.ai_context->'pending_photos', '[]'::jsonb)) pe\n      WHERE pe->>'telegram_file_id' = '{{$('Extract photo vars').item.json.file_id}}'\n    )\n  RETURNING s.id\n)\nSELECT\n  (SELECT id FROM prof)::text AS profile_id,\n  (SELECT count(*) FROM ins_photo) AS photo_inserted,\n  (SELECT count(*) FROM upd_session) AS session_updated;",
        "additionalFields": {}
      },
