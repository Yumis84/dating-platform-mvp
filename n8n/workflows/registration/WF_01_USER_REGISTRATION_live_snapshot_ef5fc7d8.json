    {"parameters": {"operation": "executeQuery", "query": "WITH existing AS (\n  SELECT user_id FROM telegram_accounts WHERE telegram_id = {{$('Extract User Info').item.json.telegram_id}}\n),\nnew_user AS (\n  INSERT INTO users (role)\n  SELECT 'man'\n  WHERE NOT EXISTS (SELECT 1 FROM existing)\n  RETURNING id\n)\nSELECT\n  COALESCE(\n    (SELECT user_id FROM existing),\n    (SELECT id FROM new_user)\n  ) AS user_id;", "additionalFields": {}}, "name": "Create user", "type": "n8n-nodes-base.postgres", "typeVersion": 1, "position": [1056, 384], "id": "67b187a4-dcd5-498a-b984-80b5a06ff058"},
    {"parameters": {"operation": "executeQuery", "query": "INSERT INTO telegram_accounts\n(user_id, telegram_id, username)\nVALUES (\n  '{{$json.user_id}}',\n  {{$('Extract User Info').item.json.telegram_id}},\n  '{{$('Extract User Info').item.json.username || \"\"}}'\n)\nON CONFLICT (telegram_id) DO NOTHING\nRETURNING user_id;", "additionalFields": {}}, "name": "Create telegram_account", "type": "n8n-nodes-base.postgres", "typeVersion": 1, "position": [1264, 384], "id": "c6fd0b88-d314-4fc5-8723-8905af42058b"},
