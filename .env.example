# Example environment variables for Dating Platform MVP

# PostgreSQL
POSTGRES_DB=EXAMPLE
POSTGRES_USER=EXAMPLE
POSTGRES_PASSWORD=EXAMPLE

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=EXAMPLE
N8N_BASIC_AUTH_PASSWORD=EXAMPLE

# WebApp
WEBAPP_URL=http://localhost:3000

# Telegram
TELEGRAM_BOT_TOKEN=EXAMPLE

# External APIs / Keys
OPENAI_API_KEY=EXAMPLE
DEEPSEEK_API_KEY=EXAMPLE

# JWT / Security
JWT_SECRET=EXAMPLE

# pgAdmin
PGADMIN_EMAIL=EXAMPLE
PGADMIN_PASSWORD=EXAMPLE

# Misc
# Optional: override postgres port mapping when running locally
POSTGRES_PORT=5432
